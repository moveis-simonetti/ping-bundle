{
  "name": "simonetti/ping-bundle",
  "type": "symfony-bundle",
  "description": "Ping Bundle",
  "keywords": [
    "ping",
    "bundle"
  ],
  "homepage": "https://github.com/moveis-simonetti/ping-bundle",
  "license": "MIT",
  "minimum-stability": "stable",
  "authors": [
    {
      "name": "Project Contributors",
      "homepage": "https://github.com/moveis-simonetti/ping-bundle/graphs/contributors"
    }
  ],
  "require": {
    "php": "^8.5",
    "symfony/config": "^7.4",
    "symfony/console": "^7.4",
    "symfony/framework-bundle": "^7.4",
    "symfony/http-foundation": "^7.4",
    "symfony/http-kernel": "^7.4",
    "symfony/lock": "^7.4"
  },
  "require-dev": {
    "psr/log": "~3.0",
    "symfony/error-handler": "^7.4",
    "symfony/phpunit-bridge": "^7.4",
    "symfony/var-dumper": "^7.4",
    "symfony/yaml": "^7.4"
  },
  "config": {
    "sort-packages": true
  },
  "autoload": {
    "psr-4": {
      "Simonetti\\PingBundle\\": "./"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Simonetti\\PingBundle\\Tests\\": "Tests"
    }
  },
  "extra": {
    "branch-alias": {
      "dev-master": "5.0.x-dev"
    }
  }
}
